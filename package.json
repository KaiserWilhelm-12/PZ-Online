{
  "name": "lanternfall",
  "version": "0.1.0",
  "private": true,
  "description": "Lanternfall - an original iPad-first, multiplayer zombie-survival sandbox for the web.",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "depcruise": "depcruise --config .dependency-cruiser.cjs apps packages",
    "check:bundles": "node scripts/check-bundle-size.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm depcruise && pnpm build && pnpm check:bundles && pnpm check:secrets"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "dependency-cruiser": "^16.4.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
