# ---------------------------------------------------------------------------
# Lanternfall environment template. Copy to .env and fill in local values.
# Never commit real secrets. Only VITE_* values reach the browser bundle.
# ---------------------------------------------------------------------------

# Game server (apps/game-server)
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# Stable world identity. Required in production; generated per boot in development.
SERVER_ID=

# Supabase JWT verification (choose JWT secret or JWKS URL)
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=

# Development-only sign-in. Must remain false in production.
DEV_AUTH_ENABLED=true
DEV_JWT_SECRET=

# Connection lifecycle (milliseconds)
HELLO_TIMEOUT_MS=5000
HEARTBEAT_INTERVAL_MS=5000
DEAD_TIMEOUT_MS=15000
SWEEP_INTERVAL_MS=1000
RECONNECT_GRACE_MS=120000

# Simulation and limits
TICK_RATE_HZ=20
MAX_PAYLOAD_BYTES=8192
MAX_PLAYERS=10
ALLOWED_ORIGINS=http://localhost:5173
METRICS_ENABLED=true

# Client (apps/client) — public values only
VITE_GAME_SERVER_URL=
